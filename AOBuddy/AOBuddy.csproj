<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AOBuddy</RootNamespace>
    <AssemblyName>AOBuddy</AssemblyName>
    <!-- Plugins live beside the host, not in their own bin\: see Directory.Build.props. -->
    <OutputPath>$(BuildRoot)Plugins\AOBuddy\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AOSharp.Common\AOSharp.Common.csproj" />
    <ProjectReference Include="..\AOSharp.Clientless.Chat\AOSharp.Clientless.Chat.csproj" />
    <ProjectReference Include="..\AOSharp.Clientless\AOSharp.Clientless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.example.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\perks.sql"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="GameData\Perks.xml"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="GameData\ItemValues.bin"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\ItemNoDrop.bin"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\ItemImplants.bin"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\ItemWantData.bin"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\Zoning.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\FactionAreas.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\Nav\**"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\ScottyWarps.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\PetShellNanos.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="GameData\ChewysBuffs.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

</Project>
